package home

import (
	"github.com/jacksongrow0/SimpleSCEP/internal/auth"
	c "github.com/jacksongrow0/SimpleSCEP/view/components"
	"github.com/jacksongrow0/SimpleSCEP/view/layout"
	"strconv"
)

// ACMEEndpointView administers one ACME endpoint. Like its SCEP counterpart,
// exactly one endpoint renders per page, which is what lets the dialogs and htmx
// targets below keep their document-global element IDs.
templ ACMEEndpointView(session auth.Session, data ACMEEndpointData) {
	@layout.App(data.Endpoint.Name+" · ACME", "protocols", shellSession(session)) {
		<div class="stack flex flex-col gap-6">
			<div class="flex items-center gap-2 text-sm text-muted-foreground">
				<a href="/protocols" class="underline-offset-2 hover:underline">Enrollment protocols</a>
				<span>/</span>
				<span class="text-foreground">{ data.Endpoint.Name }</span>
			</div>
			@ACMEEndpointSummary(data.Endpoint)
			@ACMECredentialList(data.Endpoint, data.Credentials)
			@ACMEIssuancePolicy(data.Endpoint)
			@ACMEOrderLog(data.Orders)
			@ACMEDangerZone(data.Endpoint)
		</div>
		@ACMECredentialDialog(data.Endpoint)
		@ACMEPolicyDialog(data.Endpoint)
		@ACMEDeleteDialog(data.Endpoint)
	}
}

templ ACMEDangerZone(e ACMEEndpoint) {
	<div class="rounded-xl border border-[color-mix(in_oklch,var(--color-destructive)_35%,transparent)] p-4">
		<div class="flex items-start justify-between gap-4">
			<div>
				<h4 class="m-0 font-bold">Delete this endpoint</h4>
				<p class="mt-1 mb-0 text-sm text-muted-foreground">
					Removes the directory URL, its credentials, the accounts registered against it, and its order history. Certificates it already issued keep working until they expire, but they lose the URL they renew through.
					if e.LiveCertificates > 0 {
						<strong>{ strconv.Itoa(e.LiveCertificates) } { certificateNoun(e.LiveCertificates) } currently rely on it.</strong>
					}
				</p>
			</div>
			@c.Button(c.ButtonProps{Variant: c.ButtonDestructive, Size: c.ButtonSmall, Attrs: templ.Attributes{"type": "button", "data-script": "on click call document.getElementById('acme-delete-dialog').showModal()"}}) {
				@c.Icon("trash-2")
				<span>Delete endpoint</span>
			}
		</div>
		<p id="acme-delete-error" class="mt-2 mb-0 text-sm"></p>
	</div>
}

// ACMEDeleteDialog spells out what deletion costs before it will accept it. As
// with SCEP, every consequence is delayed rather than immediate — certificates
// keep working, so nothing looks broken until renewal comes round — which is
// exactly why it is worth enumerating.
//
// The ACME-specific sting is in the second item: an ACME client renews on a
// timer with nobody watching, so the failure surfaces as an expired certificate
// in production rather than as anyone noticing an error.
templ ACMEDeleteDialog(e ACMEEndpoint) {
	@c.Dialog(c.DialogProps{Attrs: templ.Attributes{"id": "acme-delete-dialog"}}) {
		<form
			method="post"
			action={ templ.SafeURL(e.APIBase + "/delete") }
			hx-post={ e.APIBase + "/delete" }
			hx-target="#acme-delete-error"
			hx-swap="innerHTML"
		>
			@c.DialogHeader(c.DialogHeaderProps{Title: "Delete " + e.Name, Description: "This cannot be undone. A replacement endpoint gets a new directory URL, so it cannot stand in for this one."})
			@c.DialogBody(templ.Attributes{"class": "grid gap-4"}) {
				if e.LiveCertificates > 0 {
					<div class="flex items-start gap-3 rounded-xl border border-[color-mix(in_oklch,var(--color-warning)_50%,transparent)] bg-[color-mix(in_oklch,var(--color-warning)_10%,transparent)] p-4 [&>span]:text-warning">
						<span>
							@c.Icon("circle-alert")
						</span>
						<div class="text-sm">
							<strong>{ strconv.Itoa(e.LiveCertificates) } { certificateNoun(e.LiveCertificates) } issued by this endpoint { isAre(e.LiveCertificates) } still valid.</strong>
							They keep working, so nothing will look broken today. The damage appears when those clients try to renew.
						</div>
					</div>
				}
				<div class="grid gap-2 text-sm">
					<strong class="font-medium">What happens</strong>
					<ul class="m-0 grid list-disc gap-1.5 pl-5 text-muted-foreground">
						<li><strong class="text-foreground">The directory URL stops responding immediately.</strong> Every client configured with it fails its next order.</li>
						<li><strong class="text-foreground">Renewal fails silently.</strong> ACME clients renew on their own timer with nobody watching, so this will not surface as an alert. It surfaces as a certificate expiring in production weeks later. Repoint the clients at another endpoint first.</li>
						<li><strong class="text-foreground">Every credential and account is deleted.</strong> Clients that registered here lose their accounts; re-registering means minting new credentials on the replacement endpoint.</li>
						<li><strong class="text-foreground">The order history is deleted</strong>, including the record of which orders were refused and why. The certificates themselves stay listed under Certificates.</li>
					</ul>
				</div>
				<div class="grid gap-2 text-sm">
					<strong class="font-medium">What does not happen</strong>
					<ul class="m-0 grid list-disc gap-1.5 pl-5 text-muted-foreground">
						<li>No certificate is revoked. Every one stays valid and trusted until it expires. If they should stop working, revoke them from <a href="/certificates" class="underline underline-offset-2">Certificates</a> <em>before</em> deleting.</li>
						<li>The issuing CA, its key, and the CRL and OCSP responders are untouched.</li>
					</ul>
				</div>
				<p class="m-0 text-sm text-muted-foreground">If you only want to stop new enrollments, turn the endpoint off instead. That is reversible and leaves the credentials and accounts intact.</p>
				@c.Field(c.FieldProps{Label: "Type the endpoint name to confirm", Hint: "Enter " + e.Name + " exactly."}) {
					@c.Input(c.InputProps{Attrs: templ.Attributes{
						"name":         "confirm_name",
						"required":     true,
						"autocomplete": "off",
						"placeholder":  e.Name,
						"data-expect":  e.Name,
						"data-script":  "on input if my value is my @data-expect then remove @disabled from #acme-delete-submit else add @disabled to #acme-delete-submit end",
					}})
				}
			}
			@c.DialogActions(nil) {
				@c.Button(c.ButtonProps{Variant: c.ButtonGhost, Attrs: templ.Attributes{"type": "button", "data-script": "on click call (the closest <dialog/>).close()"}}) {
					Cancel
				}
				@c.Button(c.ButtonProps{Variant: c.ButtonDestructive, Attrs: templ.Attributes{"id": "acme-delete-submit", "disabled": true}}) {
					@c.Icon("trash-2")
					<span>Delete permanently</span>
				}
			}
		</form>
	}
}
