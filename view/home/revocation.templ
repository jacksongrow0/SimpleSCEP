package home

import (
	"time"

	"github.com/jacksongrow0/SimpleSCEP/internal/auth"
	c "github.com/jacksongrow0/SimpleSCEP/view/components"
	"github.com/jacksongrow0/SimpleSCEP/view/layout"
)

// Timestamps travel as instants rather than formatted strings: they are
// rendered through c.LocalTime so the browser shows them in the viewer's
// timezone instead of UTC. A nil pointer means the event has not happened.
type RevocationRow struct {
	CN, Serial, CAID, CAName, Reason string
	RevokedAt                        *time.Time
}
type DistributionPoint struct {
	CAName, CRLURL, OCSPURL, Status string
	PublishedAt, NextUpdate         *time.Time
}
type CAOption struct{ ID, Name string }
type RevocationData struct {
	Rows                      []RevocationRow
	Points                    []DistributionPoint
	CAs                       []CAOption
	RevokedCount, AffectedCAs string
	LastPublished, NextUpdate *time.Time
}

templ Revocation(session auth.Session, data RevocationData) {
	@layout.App("Revocation & OCSP", "revocation", shellSession(session)) {
		<div class="stack flex flex-col gap-6">
			<div class="grid gap-4 three grid-cols-3 max-md:grid-cols-1">
				@c.Metric(c.MetricProps{Label: "Revoked certificates", Value: data.RevokedCount, Meta: "across " + data.AffectedCAs + " issuing CAs", Icon: "shield-off"})
				@c.MetricSlot(c.MetricProps{Label: "Last published", Meta: "CRLs refresh after every revocation", Icon: "file-text"}) {
					<span class="text-xl">
						@c.LocalTimeOr(data.LastPublished, "datetime", "Never")
					</span>
				}
				@c.MetricSlot(c.MetricProps{Label: "Next update", Meta: "Auto-refresh every 24h", Icon: "clock"}) {
					<span class="text-xl">
						@c.LocalTimeOr(data.NextUpdate, "datetime", "Not scheduled")
					</span>
				}
			</div>
			@c.Card(c.CardProps{}) {
				@c.CardHeader(c.CardHeaderProps{Title: "CRL distribution points", Description: "Public CRL and OCSP endpoints embedded in newly issued certificates.", Responsive: true}) {
					<div class="button-row flex items-center gap-2 max-md:flex-col max-md:items-stretch">
						if session.CanManageCertificates() && len(data.Points) > 0 {
							@Action(session, "Republish CRLs", "publish-dialog", true)
						}
						@c.ButtonLink(c.ButtonLinkProps{Href: layout.DocsRevocationURL, ButtonProps: c.ButtonProps{Variant: c.ButtonGhost, Attrs: templ.Attributes{"target": "_blank", "rel": "noopener"}}}) {
							@c.Icon("book")
							<span>Revocation guide</span>
						}
					</div>
				}
				@c.CardBody(nil) {
					if len(data.Points) == 0 {
						@c.EmptyState(c.EmptyStateProps{Description: "Create an Issuing CA to generate a CRL distribution point.", Compact: true, Muted: true})
					} else {
						<div class="grid gap-3">
							for _, point := range data.Points {
								<div class="rounded-xl border border-border p-4">
									<div class="mb-3 flex items-center justify-between gap-3">
										<strong>{ point.CAName }</strong>
										@c.Pill(c.PillProps{}) {
											{ point.Status }
										}
									</div>
									<div class="grid gap-3 two grid-cols-2 max-md:grid-cols-1">
										@c.Info("CRL", point.CRLURL)
										@c.Info("OCSP", point.OCSPURL)
										@c.InfoSlot("Last published") {
											@c.LocalTimeOr(point.PublishedAt, "datetime", "Never")
										}
										@c.InfoSlot("Next update") {
											@c.LocalTimeOr(point.NextUpdate, "datetime", "Not scheduled")
										}
									</div>
								</div>
							}
						</div>
					}
				}
			}
			@c.Card(c.CardProps{}) {
				@c.CardHeader(c.CardHeaderProps{Title: "Revocation list", Description: "Every revoked serial published through CRL and OCSP.", Responsive: true}) {
					<div class="filter-row flex items-center gap-2 max-md:flex-col max-md:items-stretch max-md:[&>*]:w-full" data-script="on input or change set query to (<[data-search]/> in me).value.trim().toLowerCase() then set ca to (<[data-ca-filter]/> in me).value then set card to the closest <.card/> to me then for row in <[data-row]/> in card add @hidden to row when (ca is not '' and row's @data-ca is not ca) or not row.textContent.toLowerCase().includes(query) end then if (<[data-row]:not([hidden])/> in card).length is 0 remove @hidden from <[data-no-matches]/> in card else add @hidden to <[data-no-matches]/> in card end">
						@c.Select(templ.Attributes{"data-ca-filter": true}) {
							<option value="">All Issuing CAs</option>
							for _, ca := range data.CAs {
								<option value={ ca.ID }>{ ca.Name }</option>
							}
						}
						@c.Input(c.InputProps{Icon: "search", Attrs: templ.Attributes{"data-search": true, "placeholder": "Search CN or serial"}})
					</div>
				}
				@c.CardBody(nil) {
					if len(data.Rows) == 0 {
						@c.EmptyState(c.EmptyStateProps{Icon: "ban", Title: "Nothing revoked yet", Description: "Revoked certificates appear here and are published automatically."}) {
							@c.ButtonLink(c.ButtonLinkProps{Href: "/certificates"}) {
								Go to certificates 
							}
						}
					} else {
						<div class="grid gap-3">
							for _, row := range data.Rows {
								<div data-row data-ca={ row.CAID } class="flex items-start justify-between gap-4 rounded-xl border border-border p-4 max-md:flex-col">
									<div><strong>{ row.CN }</strong><p class="mt-1 mb-0 text-sm text-muted-foreground">{ row.CAName } · Serial { row.Serial }</p></div>
									<div class="text-right text-sm max-md:text-left">
										<div>{ reasonLabel(row.Reason) }</div>
										<div class="text-muted-foreground">
											@c.LocalTimeOr(row.RevokedAt, "datetime", "Unknown")
										</div>
									</div>
								</div>
							}
							<div class="text-sm text-muted-foreground" data-no-matches hidden>No revoked certificates match these filters.</div>
						</div>
					}
				}
			}
		</div>
		if session.CanManageCertificates() && len(data.Points) > 0 {
			@c.Dialog(c.DialogProps{Attrs: templ.Attributes{"id": "publish-dialog"}}) {
				<form method="post" action="/revocation/publish">
					@c.DialogHeader(c.DialogHeaderProps{Title: "Republish CRLs?", Description: "Every issuing CA distribution point will be updated immediately."})
					@c.DialogActions(nil) {
						@c.Button(c.ButtonProps{Variant: c.ButtonGhost, Attrs: templ.Attributes{"type": "button", "data-close": true, "data-script": "on click call (the closest <dialog/>).close()"}}) {
							Cancel
						}
						@c.Button(c.ButtonProps{Attrs: templ.Attributes{"type": "submit"}}) {
							Republish
						}
					}
				</form>
			}
		}
	}
}

func reasonLabel(reason string) string {
	switch reason {
	case "key_compromise":
		return "Key compromise"
	case "superseded":
		return "Superseded"
	case "cessation_of_operation":
		return "Cessation of operation"
	case "affiliation_changed":
		return "Affiliation changed"
	}
	return "Unspecified"
}
